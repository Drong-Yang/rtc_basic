# Copy to .env. Never put secrets in frontend variables.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_ENDPOINT_ID=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
RTC_APP_ID=
RTC_APP_KEY=
SERVER_URL=
CALLBACK_API_KEY=
# milvus / cloud are real retrieval backends; sample is local keyword demo only.
KB_MODE=sample
KB_COLLECTION_NAME=
KB_PROJECT_NAME=default
VOLC_ACCOUNT_ID=
MOCK_MODE=false

# Milvus 2.4+ server REST v2; create a separate collection, never reuse unrelated data.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=default
MILVUS_COLLECTION=voice_commerce_v1
MILVUS_TOKEN=
MILVUS_MIN_SCORE=0.45
MILVUS_TIMEOUT=2
# Reuse ARK_API_KEY when EMBEDDING_API_KEY is empty.
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_API_PATH=/embeddings/multimodal
EMBEDDING_DIMENSIONS=2048
EMBEDDING_TIMEOUT=3
